<robot name="arm">
    <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1"/>
    </material>
    <material name="blue">
        <color rgba="0.0 0.4 0.8 1"/>
    </material>
    <material name="orange">
        <color rgba="0.9 0.45 0.1 1"/>
    </material>
    <material name="teal">
        <color rgba="0.0 0.6 0.6 1"/>
    </material>
    <material name="yellow">
        <color rgba="0.95 0.75 0.1 1"/>
    </material>

    <link name="world"/>

    <link name="base_link">
        <inertial>
            <mass value="0.67"/>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
        </inertial>
        <visual>
            <geometry>
                <cylinder length="0.1" radius="0.2"/>
            </geometry>
            <material name="dark_grey"/>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.1" radius="0.2"/>
            </geometry>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
        </collision>
    </link>

    <joint name="fixed" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
    </joint>

    <link name="shoulder_link">
        <inertial>
            <mass value="0.5"/>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
        </inertial>
        <visual>
            <geometry>
                <cylinder length="0.2" radius="0.1"/>
            </geometry>
            <material name="blue"/>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.2" radius="0.1"/>
            </geometry>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
        </collision>
    </link>

    <joint name="joint_1_hip" type="revolute">
        <parent link="base_link"/>
        <child link="shoulder_link"/>
        <axis xyz="0 0 1"/>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
        <limit lower="-3.14" upper="3.14" effort="100" velocity="1.0"/>
    </joint>

    <link name="upper_arm_link">
        <inertial>
            <mass value="0.5"/>
            <origin xyz="0 0 0.25" rpy="0 0 0"/>
        </inertial>
        <visual>
            <geometry>
                <cylinder length="0.5" radius="0.075"/>
            </geometry>
            <material name="orange"/>
            <origin xyz="0 0 0.25" rpy="0 0 0"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.5" radius="0.075"/>
            </geometry>
            <origin xyz="0 0 0.25" rpy="0 0 0"/>
        </collision>
    </link>

    <joint name="joint_2_shoulder" type="revolute">
        <parent link="shoulder_link"/>
        <child link="upper_arm_link" />
        <origin xyz="0 -0.175 0.15" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="100" velocity="1.0"/>
    </joint>

    <link name="forearm_link">
        <inertial>
            <mass value="0.5"/>
            <origin xyz="0 0 0.2" rpy="0 0 0"/>
        </inertial>
        <visual>
            <geometry>
                <cylinder length="0.5" radius="0.05"/>
            </geometry>
            <material name="teal"/>
            <origin xyz="0 0 0.2" rpy="0 0 0"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.5" radius="0.05"/>
            </geometry>
            <origin xyz="0 0 0.2" rpy="0 0 0"/>
        </collision>
    </link>

    <joint name="joint_3_elbow" type="revolute">
        <parent link="upper_arm_link"/>
        <child link="forearm_link"/>
        <axis xyz="0 1 0"/>
        <origin xyz="0 0.125 0.45" rpy="0 0 0"/>
        <limit lower="-2.35" upper="2.35" effort="100" velocity="1.0"/>
    </joint>

    <link name="wrist_link">
         <inertial>
            <mass value="0.5"/>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
        </inertial>
        <visual>
            <geometry>
                <cylinder length="0.1" radius="0.05"/>
            </geometry>
            <material name="yellow"/>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.05" radius="0.05"/>
            </geometry>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
        </collision>
    </link>

    <joint name="joint_4_wrist" type="revolute">
        <parent link="forearm_link"/>
        <child link="wrist_link"/>
        <axis xyz="0 1 0"/>
        <origin xyz="0 0 0.45" rpy="0 0 0"/>
        <limit lower="-1.57" upper="1.57" effort="100" velocity="1.0"/>
    </joint>

    <link name="roll_link">
        <inertial>
            <mass value="0.2"/>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
        </inertial>
        <visual>
            <geometry>
                <cylinder length="0.1" radius="0.04"/>
            </geometry>
            <material name="dark_grey"/>
            <origin xyz="0 0 0.05" rpy="1.5708 0 0"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.1" radius="0.04"/>
            </geometry>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
        </collision>
    </link>

    <joint name="joint_5_roll" type="revolute">
        <parent link="wrist_link"/>
        <child link="roll_link"/>
        <axis xyz="0 0 1"/>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <limit lower="-3.14" upper="3.14" effort="100" velocity="1.0"/>
    </joint>
</robot>