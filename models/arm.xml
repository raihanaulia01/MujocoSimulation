<mujoco model="arm_4dof">
  <compiler angle="degree"/>

  <!-- 1. Default values (biar ga nulis atribut sama berulang-ulang) -->
  <default>
    <joint damping="0" range="-90 90"/>
    <geom contype="0" conaffinity="0"/>
  </default>

  <!-- 4. Struktur fisik: body tree -->
  <worldbody>
    <light diffuse=".6 .6 .6" pos="0 0 3" dir="0 0 -1"/>
    <geom type="plane" size="2 2 0.1" rgba=".9 .9 .9 1"/>

    <!-- Base / pedestal (fixed to world) -->
    <body name="base" pos="0 0 0.1">
      <geom type="cylinder" size="0.1 0.1" rgba="0.3 0.3 0.3 1"/>

      <!-- Joint 1: base yaw (sumbu Z) -->
      <body name="link1" pos="0 0 0.1">
        <joint name="j1_base_yaw" type="hinge" axis="0 0 1" range="-180 180"/>
        <geom type="cylinder" size="0.06 0.08" rgba="0.8 0.2 0.2 1"/>

        <!-- Joint 2: shoulder pitch (sumbu Y) -->
        <body name="link2" pos="0 0 0.08">
          <joint name="j2_shoulder_pitch" type="hinge" axis="0 1 0" range="-90 90"/>
          <geom type="capsule" fromto="0 0 0  0 0 0.35" size="0.045" rgba="0.2 0.6 0.8 1"/>

          <!-- Joint 3: elbow pitch (sumbu Y) -->
          <body name="link3" pos="0 0 0.35">
            <joint name="j3_elbow_pitch" type="hinge" axis="0 1 0" range="-150 150"/>
            <geom type="capsule" fromto="0 0 0  0 0 0.28" size="0.04" rgba="0.2 0.8 0.4 1"/>

            <!-- Joint 4: wrist pitch (sumbu Y) -->
            <body name="link4" pos="0 0 0.28">
              <joint name="j4_wrist_pitch" type="hinge" axis="0 1 0" range="-100 100"/>
              <geom type="capsule" fromto="0 0 0  0 0 0.15" size="0.03" rgba="0.9 0.7 0.1 1"/>

              <!-- End effector marker -->
              <site name="ee_site" pos="0 0 0.15" size="0.02" rgba="1 0 0 1"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>