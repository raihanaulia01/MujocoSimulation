<mujoco model="arm">
  <compiler angle="radian" />

  <default>
    <geom contype="0" conaffinity="0"/>
  </default>

  <worldbody>
    <light diffuse="0.9 0.9 0.9" pos="0 0 10" dir="0 0 -1"/>
    <geom type="plane" size="5 5 0.1" material="white_grey"/>

    <body name="world_link" pos="0 0 0">
      <body name="base_link">
        <geom name="base_link" pos="0 0 0.05" type="cylinder" size="0.2 0.05" material="dark_grey"/>

        <body name="shoulder_link" pos="0 0 0.1">
          <joint name="joint_1_hip" type="hinge" range="-3.14 3.14" axis="0 0 1" />
          <geom name="shoulder_link" pos="0 0 0.1" type="cylinder" size="0.1 0.1" material="blue"/>

          <body name="upper_arm_link" pos="0 -0.175 0.15">
            <joint name="joint_2_shoulder" type="hinge" range="-1.57 1.57" axis="0 1 0" />
            <geom name="upper_arm_link" pos="0 0 0.25" type="cylinder" size="0.075 0.25" material="orange"/>

            <body name="forearm_link" pos="0 0.125 0.45">
              <joint name="joint_3_elbow" type="hinge" range="-2.35 2.35" axis="0 1 0" />
              <geom name="forearm_link" pos="0 0 0.2" type="cylinder" size="0.05 0.25" material="teal"/>

              <body name="wrist_link" pos="0 0 0.45">
                <joint name="joint_4_wrist" type="hinge" range="-1.57 1.57" axis="0 1 0" />
                <geom name="wrist_link" pos="0 0 0.05" type="cylinder" size="0.05 0.05" material="yellow"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <asset>
    <material name="white_grey" rgba="0.85 0.85 0.85 1" />
    <material name="dark_grey" rgba="0.2 0.2 0.2 1" />
    <material name="blue" rgba="0.0 0.4 0.8 1" />
    <material name="orange" rgba="0.9 0.45 0.1 1" />
    <material name="teal" rgba="0.0 0.6 0.6 1" />
    <material name="yellow" rgba="0.95 0.75 0.1 1" />
  </asset>

  <actuator>
    <motor name="joint_1_hip" joint="joint_1_hip" />
    <motor name="joint_2_shoulder" joint="joint_2_shoulder" />
    <motor name="joint_3_elbow" joint="joint_3_elbow" />
    <motor name="joint_4_wrist" joint="joint_4_wrist" />
  </actuator>

  <sensor>
    <jointpos name="joint_1_hip_pos" joint="joint_1_hip"/>
    <jointpos name="joint_2_shoulder_pos" joint="joint_2_shoulder"/>
    <jointpos name="joint_3_elbow_pos" joint="joint_3_elbow"/>
    <jointpos name="joint_4_wrist_pos" joint="joint_4_wrist"/>
  </sensor>
</mujoco>